    "Go to the Studio tab to configure your backdrop and product objects, then generate your first photograph.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zur Registerkarte „Studio“, um Ihren Hintergrund und Ihre Produktobjekte zu konfigurieren, und erstellen Sie dann Ihr erstes Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaya a la pestaña Estudio para configurar el fondo y los objetos del producto, luego genere su primera fotografía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez à l'onglet Studio pour configurer votre toile de fond et vos objets produits, puis générez votre première photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पृष्ठभूमि और उत्पाद ऑब्जेक्ट को कॉन्फ़िगर करने के लिए स्टूडियो टैब पर जाएं, फिर अपनी पहली तस्वीर तैयार करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tab Studio untuk mengonfigurasi latar belakang dan objek produk Anda, lalu buat foto pertama Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[スタジオ] タブに移動して背景と製品オブジェクトを構成し、最初の写真を生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스튜디오 탭으로 이동하여 배경화면과 제품 개체를 구성한 다음 첫 번째 사진을 생성하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do zakładki Studio, aby skonfigurować tło i obiekty produktowe, a następnie wygeneruj swoje pierwsze zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá para a aba Studio para configurar seu cenário e objetos de produto e, em seguida, gere sua primeira fotografia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planınızı ve ürün nesnelerinizi yapılandırmak için Stüdyo sekmesine gidin, ardından ilk fotoğrafınızı oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдіть на вкладку «Студія», щоб налаштувати фон і об’єкти продукту, а потім створіть свою першу фотографію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi tới tab Studio để định cấu hình phông nền và đối tượng sản phẩm, sau đó tạo bức ảnh đầu tiên của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转到“工作室”选项卡配置您的背景和产品对象，然后生成您的第一张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往「工作室」標籤配置您的背景和產品對象，然後產生您的第一張照片。"
          }
        }
      }
    },
