    "Configure a provider with models that support reference images and standard aspect ratios.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie einen Anbieter mit Modellen, die Referenzbilder und Standardseitenverhältnisse unterstützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure un proveedor con modelos que admitan imágenes de referencia y relaciones de aspecto estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un fournisseur avec des modèles prenant en charge les images de référence et les proportions standard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रदाता को उन मॉडलों के साथ कॉन्फ़िगर करें जो संदर्भ छवियों और मानक पहलू अनुपात का समर्थन करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasikan penyedia dengan model yang mendukung gambar referensi dan rasio aspek standar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照画像と標準のアスペクト比をサポートするモデルを使用してプロバイダーを構成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 이미지와 표준 종횡비를 지원하는 모델로 공급자를 구성합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj dostawcę z modelami obsługującymi obrazy referencyjne i standardowe współczynniki proporcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure um provedor com modelos que suportem imagens de referência e proporções padrão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans görsellerini ve standart en boy oranlarını destekleyen modellerle bir sağlayıcı yapılandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте постачальника з моделями, які підтримують еталонні зображення та стандартні пропорції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định cấu hình nhà cung cấp với các mô hình hỗ trợ hình ảnh tham chiếu và tỷ lệ khung hình tiêu chuẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用支持参考图像和标准纵横比的模型配置提供程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用支援參考影像和標準縱橫比的模型配置提供者。"
          }
        }
      }
    },
