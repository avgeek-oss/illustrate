    "Image has been saved to your photo library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild wurde in Ihrer Fotobibliothek gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen se ha guardado en su biblioteca de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image a été enregistrée dans votre photothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि आपकी फ़ोटो लाइब्रेरी में सहेजी गई है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar telah disimpan ke perpustakaan foto Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像がフォト ライブラリに保存されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 사진 라이브러리에 저장되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
