    "You can connect via the providers page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können sich über die Anbieterseite verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede conectarse a través de la página de proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez vous connecter via la page des fournisseurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप प्रदाता पृष्ठ के माध्यम से जुड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
