            "value": "Silakan perluas jendela untuk mengakses fitur ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能にアクセスするには、ウィンドウを展開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능에 액세스하려면 창을 확장하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
