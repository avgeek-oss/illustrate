    "This action cannot be undone. The selected items and their associated images will be permanently removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion kann nicht rückgängig gemacht werden. Die ausgewählten Elemente und die zugehörigen Bilder werden dauerhaft entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Los elementos seleccionados y sus imágenes asociadas se eliminarán permanentemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ne peut pas être annulée. Les éléments sélectionnés et leurs images associées seront définitivement supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्रिया को पूर्ववत नहीं किया जा सकता. चयनित आइटम और उनसे संबंधित छवियाँ स्थायी रूप से हटा दी जाएंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak dapat dibatalkan. Item yang dipilih dan gambar terkaitnya akan dihapus secara permanen."
