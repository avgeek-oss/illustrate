          "stringUnit": {
            "state": "translated",
            "value": "A imagem foi salva em sua biblioteca de fotos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resim, fotoğraf kitaplığınıza kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення збережено у вашій бібліотеці фотографій."
