          }
        }
      }
    },
    "Choose a storyboard from the sidebar or create a new one to start building multi-scene movies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in der Seitenleiste ein Storyboard aus oder erstellen Sie ein neues, um mit der Erstellung von Filmen mit mehreren Szenen zu beginnen."
          }
        },
        "es": {
