    "Please expand the window to access this feature.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erweitern Sie das Fenster, um auf diese Funktion zuzugreifen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda la ventana para acceder a esta función."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez agrandir la fenêtre pour accéder à cette fonctionnalité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया इस सुविधा तक पहुंचने के लिए विंडो का विस्तार करें।"
          }
        },
        "id": {
          "stringUnit": {
