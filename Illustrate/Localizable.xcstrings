            "state": "translated",
            "value": "공급자 페이지를 통해 연결할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz połączyć się poprzez stronę dostawców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode se conectar através da página de provedores."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcıların sayfasından bağlanabilirsiniz."
          }
        },
        "uk": {
