    "Choose a session from the list or create a new one to start bulk editing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Sitzung aus der Liste aus oder erstellen Sie eine neue, um mit der Massenbearbeitung zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una sesión de la lista o cree una nueva para comenzar la edición masiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une session dans la liste ou créez-en une nouvelle pour lancer la modification groupée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थोक संपादन शुरू करने के लिए सूची से एक सत्र चुनें या एक नया सत्र बनाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sesi dari daftar atau buat sesi baru untuk memulai pengeditan massal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストからセッションを選択するか、新しいセッションを作成して一括編集を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 세션을 선택하거나 새 세션을 만들어 대량 편집을 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sesję z listy lub utwórz nową, aby rozpocząć edycję zbiorczą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma sessão na lista ou crie uma nova para iniciar a edição em massa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplu düzenlemeye başlamak için listeden bir oturum seçin veya yeni bir oturum oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть сеанс зі списку або створіть новий, щоб почати масове редагування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một phiên từ danh sách hoặc tạo một phiên mới để bắt đầu chỉnh sửa hàng loạt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中选择一个会话或创建一个新会话以开始批量编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從清單中選擇一個會話或建立新會話以開始批次編輯。"
          }
        }
      }
    },
