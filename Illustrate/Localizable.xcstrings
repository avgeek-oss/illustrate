    "Changing dimensions will remove all current layers. This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ändern der Abmessungen werden alle aktuellen Ebenen entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar las dimensiones eliminará todas las capas actuales. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification des dimensions supprimera tous les calques actuels. Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयाम बदलने से सभी मौजूदा परतें हट जाएंगी। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah dimensi akan menghapus semua lapisan saat ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寸法を変更すると、現在のレイヤーがすべて削除されます。この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치수를 변경하면 현재 레이어가 모두 제거됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana wymiarów spowoduje usunięcie wszystkich bieżących warstw. Tej akcji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar as dimensões removerá todas as camadas atuais. Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutların değiştirilmesi mevcut tüm katmanları kaldıracaktır. Bu eylem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна розмірів призведе до видалення всіх поточних шарів. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc thay đổi kích thước sẽ loại bỏ tất cả các lớp hiện tại. Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改尺寸将删除所有当前图层。此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改尺寸將刪除所有目前圖層。此操作無法撤銷。"
          }
        }
      }
    },
