    "Video will be generated transitioning from the first image to the second.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video wird beim Übergang vom ersten zum zweiten Bild generiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo se generará pasando de la primera imagen a la segunda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo sera générée en passant de la première image à la seconde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली छवि से दूसरी छवि में परिवर्तन करते हुए वीडियो तैयार किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video akan dihasilkan transisi dari gambar pertama ke gambar kedua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の画像から 2 番目の画像に遷移するビデオが生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 이미지에서 두 번째 이미지로 전환되는 비디오가 생성됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film będzie generowany przy przejściu z pierwszego obrazu do drugiego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vídeo será gerado fazendo a transição da primeira imagem para a segunda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, ilk görüntüden ikinciye geçiş yapılarak oluşturulacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео буде створено з переходом від першого зображення до другого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video sẽ được tạo chuyển từ hình ảnh đầu tiên sang hình ảnh thứ hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将生成从第一张图像过渡到第二张图像的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將產生從第一張影像過渡到第二張影像的影片。"
          }
        }
      }
    },
