        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande est trop volumineuse. Veuillez réduire la taille de l'image ou la longueur de l'invite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध बहुत बड़ा है. कृपया छवि का आकार या शीघ्र लंबाई कम करें।"
