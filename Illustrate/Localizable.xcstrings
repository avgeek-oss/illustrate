    "Prefer to upload the transparent images for better results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie lieber die transparenten Bilder hoch, um bessere Ergebnisse zu erzielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiere cargar las imágenes transparentes para obtener mejores resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférez télécharger les images transparentes pour de meilleurs résultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतर परिणामों के लिए पारदर्शी छवियाँ अपलोड करना पसंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih suka mengunggah gambar transparan untuk hasil yang lebih baik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より良い結果を得るには、透明な画像をアップロードすることをお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 나은 결과를 얻으려면 투명한 이미지를 업로드하는 것이 좋습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uzyskać lepsze wyniki, wolę przesyłać przezroczyste obrazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefira fazer upload de imagens transparentes para melhores resultados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi sonuçlar için şeffaf görselleri yüklemeyi tercih edin."
