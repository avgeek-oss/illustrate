        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 프롬프트 갤러리에 프롬프트를 저장한 다음 여기에서 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zapisz podpowiedzi w Galerii podpowiedzi, a następnie wybierz je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
