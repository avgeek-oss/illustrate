    "Describe your brand to help generate consistent content that matches your identity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie Ihre Marke, um konsistente Inhalte zu generieren, die zu Ihrer Identität passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe tu marca para ayudar a generar contenido coherente que coincida con tu identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez votre marque pour aider à générer un contenu cohérent qui correspond à votre identité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पहचान से मेल खाने वाली सुसंगत सामग्री उत्पन्न करने में सहायता के लिए अपने ब्रांड का वर्णन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan merek Anda untuk membantu menghasilkan konten yang konsisten dan sesuai dengan identitas Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデンティティに一致する一貫したコンテンツを生成できるように、ブランドについて説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 정체성과 일치하는 일관된 콘텐츠를 생성하는 데 도움이 되도록 귀하의 브랜드를 설명하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz swoją markę, aby pomóc w generowaniu spójnych treści pasujących do Twojej tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva sua marca para ajudar a gerar conteúdo consistente que corresponda à sua identidade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizle eşleşen tutarlı içerik oluşturmaya yardımcı olmak için markanızı tanımlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть свій бренд, щоб створити узгоджений вміст, який відповідає вашій особистості."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả thương hiệu của bạn để giúp tạo ra nội dung nhất quán phù hợp với danh tính của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述您的品牌，以帮助生成与您的身份相符的一致内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述您的品牌，以幫助產生與您的身分相符的一致內容。"
          }
        }
      }
    },
