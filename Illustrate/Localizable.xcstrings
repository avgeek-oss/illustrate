    "Your images are ready. Click Start to begin bulk editing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Bilder sind fertig. Klicken Sie auf „Start“, um mit der Massenbearbeitung zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus imágenes están listas. Haga clic en Iniciar para comenzar la edición masiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos images sont prêtes. Cliquez sur Démarrer pour commencer la modification groupée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी छवियां तैयार हैं. बल्क संपादन शुरू करने के लिए स्टार्ट पर क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar Anda sudah siap. Klik Mulai untuk memulai pengeditan massal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の準備ができました。 「開始」をクリックして一括編集を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 준비되었습니다. 대량 편집을 시작하려면 시작을 클릭하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje obrazy są gotowe. Kliknij przycisk Start, aby rozpocząć edycję zbiorczą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas imagens estão prontas. Clique em Iniciar para iniciar a edição em massa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimleriniz hazır. Toplu düzenlemeye başlamak için Başlat'a tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші зображення готові. Натисніть «Почати», щоб розпочати масове редагування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh của bạn đã sẵn sàng. Nhấp vào Bắt đầu để bắt đầu chỉnh sửa hàng loạt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的图像已准备就绪。单击“开始”开始批量编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的影像已準備就緒。點選“開始”開始批次編輯。"
          }
        }
      }
    },
    "Your product photograph is being generated. It will appear in the Gallery tab once it's ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Produktfoto wird erstellt. Sobald es fertig ist, wird es auf der Registerkarte „Galerie“ angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está generando la fotografía de su producto. Aparecerá en la pestaña Galería una vez que esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photographie de votre produit est en cours de génération. Il apparaîtra dans l'onglet Galerie une fois qu'il sera prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके उत्पाद का फोटोग्राफ तैयार किया जा रहा है. तैयार होने पर यह गैलरी टैब में दिखाई देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto produk Anda sedang dibuat. Ini akan muncul di tab Galeri setelah siap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "製品写真が生成されています。準備が完了すると、[ギャラリー] タブに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품 사진을 생성하는 중입니다. 준비가 되면 갤러리 탭에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa generowanie zdjęcia Twojego produktu. Gdy będzie gotowy, pojawi się w zakładce Galeria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia do seu produto está sendo gerada. Ele aparecerá na guia Galeria quando estiver pronto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürün fotoğrafınız oluşturuluyor. Hazır olduğunda Galeri sekmesinde görünecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографія вашого товару створюється. Коли буде готове, воно з’явиться на вкладці «Галерея»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh sản phẩm của bạn đang được tạo. Nó sẽ xuất hiện trong tab Thư viện khi đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在生成您的产品照片。准备就绪后，它将出现在“图库”选项卡中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在產生您的產品照片。準備好後，它將出現在「圖庫」標籤中。"
          }
        }
      }
    },
    "Your prompts are ready. Click Start to begin bulk generation.": {
