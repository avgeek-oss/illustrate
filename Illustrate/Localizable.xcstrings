    "Use the prompt bar to generate brand-consistent assets like posters, invitations, and social media content.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Eingabeaufforderungsleiste, um markenkonsistente Assets wie Poster, Einladungen und Social-Media-Inhalte zu generieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la barra de mensajes para generar activos coherentes con la marca, como carteles, invitaciones y contenido de redes sociales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la barre d'invite pour générer des éléments cohérents avec la marque, tels que des affiches, des invitations et du contenu pour les réseaux sociaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्टर, निमंत्रण और सोशल मीडिया सामग्री जैसी ब्रांड-संगत संपत्तियां उत्पन्न करने के लिए प्रॉम्प्ट बार का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan bilah perintah untuk menghasilkan aset yang konsisten dengan merek seperti poster, undangan, dan konten media sosial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプト バーを使用して、ポスター、招待状、ソーシャル メディア コンテンツなどのブランドと一貫したアセットを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트 표시줄을 사용하여 포스터, 초대장, 소셜 미디어 콘텐츠 등 브랜드와 일치하는 자산을 생성하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj paska podpowiedzi, aby wygenerować zasoby spójne z marką, takie jak plakaty, zaproszenia i treści w mediach społecznościowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a barra de prompt para gerar ativos consistentes com a marca, como pôsteres, convites e conteúdo de mídia social."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posterler, davetiyeler ve sosyal medya içeriği gibi markayla tutarlı varlıklar oluşturmak için bilgi istemi çubuğunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте панель підказок, щоб створювати ресурси, узгоджені з брендом, як-от плакати, запрошення та вміст соціальних мереж."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng thanh nhắc nhở để tạo nội dung phù hợp với thương hiệu như áp phích, lời mời và nội dung mạng xã hội."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用提示栏生成品牌一致的资产，例如海报、邀请函和社交媒体内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用提示欄產生品牌一致的資產，例如海報、邀請函和社群媒體內容。"
          }
        }
      }
    },
    "Use the tools below to add layers to your canvas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die folgenden Werkzeuge, um Ihrer Leinwand Ebenen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice las herramientas siguientes para agregar capas a su lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les outils ci-dessous pour ajouter des calques à votre toile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कैनवास में परतें जोड़ने के लिए नीचे दिए गए टूल का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan alat di bawah ini untuk menambahkan lapisan ke kanvas Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
