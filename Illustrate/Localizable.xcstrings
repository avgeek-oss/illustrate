        }
      }
    },
    "The request timed out. Please check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anfrage ist eine Zeitüberschreitung aufgetreten. Bitte überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
