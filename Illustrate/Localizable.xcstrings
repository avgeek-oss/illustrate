        }
      }
    },
    "Your generation request has been queued and will start processing shortly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Generierungsanfrage wurde in die Warteschlange gestellt und wird in Kürze bearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su solicitud de generación ha sido puesta en cola y comenzará a procesarse en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre demande de génération a été mise en file d'attente et commencera à être traitée sous peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जनरेशन अनुरोध कतारबद्ध कर दिया गया है और शीघ्र ही प्रसंस्करण शुरू हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan pembuatan Anda telah dimasukkan dalam antrean dan akan segera diproses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成リクエストはキューに入れられており、間もなく処理が開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 생성 요청이 대기 중이며 곧 처리가 시작됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje żądanie wygenerowania zostało umieszczone w kolejce i wkrótce rozpocznie przetwarzanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua solicitação de geração foi colocada na fila e começará a ser processada em breve."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturma isteğiniz sıraya alındı ve kısa süre içinde işlenmeye başlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш запит на створення поставлено в чергу й незабаром почнеться обробка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu tạo của bạn đã được xếp hàng đợi và sẽ sớm bắt đầu xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的生成请求已排队，很快就会开始处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的生成請求已排隊，很快就會開始處理。"
          }
        }
      }
    },
    "Your generation request has been queued and will start processing shortly. You can keep adding requests, they'll process one after another. Completed generations appear in your the gallery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Generierungsanfrage wurde in die Warteschlange gestellt und wird in Kürze bearbeitet. Sie können weitere Anfragen hinzufügen, diese werden dann eine nach der anderen bearbeitet. Abgeschlossene Generationen werden in Ihrer Galerie angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su solicitud de generación ha sido puesta en cola y comenzará a procesarse en breve. Puede seguir agregando solicitudes, se procesarán una tras otra. Las generaciones completadas aparecen en tu galería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre demande de génération a été mise en file d'attente et commencera à être traitée sous peu. Vous pouvez continuer à ajouter des demandes, elles seront traitées les unes après les autres. Les générations terminées apparaissent dans votre galerie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जनरेशन अनुरोध कतारबद्ध कर दिया गया है और शीघ्र ही प्रसंस्करण शुरू हो जाएगा। आप अनुरोध जोड़ना जारी रख सकते हैं, वे एक के बाद एक प्रक्रिया करेंगे। पूरी हो चुकी पीढ़ियाँ आपकी गैलरी में दिखाई देती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan pembuatan Anda telah dimasukkan dalam antrean dan akan segera diproses. Anda dapat terus menambahkan permintaan, permintaan tersebut akan diproses satu demi satu. Generasi yang telah selesai muncul di galeri Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成リクエストはキューに入れられており、間もなく処理が開始されます。リクエストを追加し続けると、次々に処理されます。完了した世代がギャラリーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 생성 요청이 대기 중이며 곧 처리가 시작됩니다. 요청을 계속 추가하면 하나씩 처리됩니다. 완성된 세대가 갤러리에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje żądanie wygenerowania zostało umieszczone w kolejce i wkrótce rozpocznie przetwarzanie. Możesz dodawać prośby, będą one przetwarzane jedna po drugiej. Ukończone pokolenia pojawią się w Twojej galerii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua solicitação de geração foi colocada na fila e começará a ser processada em breve. Você pode continuar adicionando solicitações, elas serão processadas uma após a outra. Gerações completadas aparecem na sua galeria."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturma isteğiniz sıraya alındı ve kısa süre içinde işlenmeye başlayacak. İstek eklemeye devam edebilirsiniz, birbiri ardına işleneceklerdir. Tamamlanan nesiller galerinizde görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш запит на створення поставлено в чергу й незабаром почнеться обробка. Ви можете продовжувати додавати запити, вони будуть оброблятися один за одним. Завершені покоління відображаються у вашій галереї."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu tạo của bạn đã được xếp hàng đợi và sẽ sớm bắt đầu xử lý. Bạn có thể tiếp tục thêm yêu cầu, chúng sẽ xử lý lần lượt từng yêu cầu. Các thế hệ đã hoàn thành sẽ xuất hiện trong thư viện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的生成请求已排队，很快就会开始处理。您可以继续添加请求，他们会一个接一个地处理。已完成的几代出现在您的画廊中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的生成請求已排隊，很快就會開始處理。您可以繼續新增請求，他們會一個接一個地處理。已完成的幾代人出現在您的畫廊中。"
          }
        }
      }
    },
    "Your go-to workplace dashboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Arbeitsplatz-Dashboard"
          }
        },
        "es": {
