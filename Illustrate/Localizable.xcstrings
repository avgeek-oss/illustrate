    "Describe your subject (e.g., organic sunscreen bottle, luxury skincare...)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie Ihr Thema (z. B. Bio-Sonnenschutzflasche, Luxus-Hautpflege...)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
