    "Create a photoshoot to start generating professional product photographs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie ein Fotoshooting, um professionelle Produktfotos zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sesión de fotos para comenzar a generar fotografías de productos profesionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une séance photo pour commencer à générer des photographies de produits professionnelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेशेवर उत्पाद तस्वीरें तैयार करना शुरू करने के लिए एक फोटोशूट बनाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat pemotretan untuk mulai menghasilkan foto produk profesional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真撮影を作成して、プロ仕様の製品写真の生成を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전문적인 제품 사진 생성을 시작하려면 사진 촬영을 만드세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz sesję zdjęciową, aby rozpocząć generowanie profesjonalnych zdjęć produktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma sessão de fotos para começar a gerar fotos profissionais de produtos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesyonel ürün fotoğrafları oluşturmaya başlamak için bir fotoğraf çekimi oluşturun."
          }
        },
        "uk": {
