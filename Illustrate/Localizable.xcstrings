    "Agent usually consumes upto 500-2000 credits per request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent verbraucht normalerweise bis zu 500–2000 Credits pro Anfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente suele consumir entre 500 y 2000 créditos por solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent consomme généralement entre 500 et 2 000 crédits par demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट आमतौर पर प्रति अनुरोध 500-2000 क्रेडिट तक का उपभोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen biasanya menggunakan hingga 500-2000 kredit per permintaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは通常、リクエストごとに最大 500 ～ 2000 クレジットを消費します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 일반적으로 요청당 최대 500~2000크레딧을 소비합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent zwykle zużywa do 500-2000 kredytów na żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente geralmente consome de 500 a 2.000 créditos por solicitação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temsilci genellikle istek başına 500-2000 krediye kadar tüketir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент зазвичай витрачає до 500-2000 кредитів на запит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đại lý thường tiêu thụ tới 500-2000 tín dụng cho mỗi yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理每次请求通常消耗最多 500-2000 个积分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理每次請求通常消耗最多 500-2000 個積分。"
          }
        }
      }
    },
