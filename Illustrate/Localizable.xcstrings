    "Add your first scene to start building your storyboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ihre erste Szene hinzu, um mit der Erstellung Ihres Storyboards zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega tu primera escena para comenzar a construir tu guión gráfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre première scène pour commencer à créer votre storyboard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना स्टोरीबोर्ड बनाना शुरू करने के लिए अपना पहला दृश्य जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan adegan pertama Anda untuk mulai membuat storyboard Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のシーンを追加して、ストーリーボードの作成を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토리보드 구축을 시작하려면 첫 번째 장면을 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swoją pierwszą scenę, aby rozpocząć tworzenie scenorysu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua primeira cena para começar a construir seu storyboard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hikaye taslağınızı oluşturmaya başlamak için ilk sahnenizi ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте першу сцену, щоб почати створювати розкадровку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm cảnh đầu tiên của bạn để bắt đầu xây dựng bảng phân cảnh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您的第一个场景以开始构建故事板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您的第一個場景以開始建立故事板。"
          }
        }
      }
    },
    "Add your products here to quickly use them in product photoshoots.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie hier Ihre Produkte hinzu, um sie schnell in Produktfotoshootings zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue sus productos aquí para usarlos rápidamente en sesiones de fotos de productos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos produits ici pour les utiliser rapidement dans des séances photo de produits."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्पाद फोटोशूट में शीघ्रता से उपयोग करने के लिए अपने उत्पादों को यहां जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan produk Anda di sini untuk menggunakannya dengan cepat dalam pemotretan produk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに商品を追加すると、商品の写真撮影ですぐに使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품 사진 촬영에 빠르게 사용하려면 여기에 제품을 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj tutaj swoje produkty, aby szybko wykorzystać je w sesjach zdjęciowych produktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seus produtos aqui para usá-los rapidamente em sessões de fotos de produtos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürün fotoğraf çekimlerinde hızlı bir şekilde kullanmak için ürünlerinizi buraya ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте тут свої продукти, щоб швидко використовувати їх у фотосесіях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
