    "The request is too large. Please reduce the image size or prompt length.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage ist zu groß. Bitte reduzieren Sie die Bildgröße oder die Eingabeaufforderungslänge."
          }
        },
        "es": {
          "stringUnit": {
