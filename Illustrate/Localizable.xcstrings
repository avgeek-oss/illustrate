    "Choose a photoshoot from the sidebar or create a new one to start generating professional product photographs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in der Seitenleiste ein Fotoshooting aus oder erstellen Sie ein neues, um mit der Erstellung professioneller Produktfotos zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una sesión de fotos en la barra lateral o cree una nueva para comenzar a generar fotografías de productos profesionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une séance photo dans la barre latérale ou créez-en une nouvelle pour commencer à générer des photographies de produits professionnelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेशेवर उत्पाद तस्वीरें बनाना शुरू करने के लिए साइडबार से एक फोटोशूट चुनें या एक नया फोटोशूट बनाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pemotretan dari sidebar atau buat yang baru untuk mulai menghasilkan foto produk profesional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーから写真撮影を選択するか、新しい写真を作成してプロ仕様の製品写真の生成を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 사진 촬영을 선택하거나 새 사진을 만들어 전문적인 제품 사진 생성을 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sesję zdjęciową z paska bocznego lub utwórz nową i zacznij generować profesjonalne zdjęcia produktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma sessão de fotos na barra lateral ou crie uma nova para começar a gerar fotos profissionais de produtos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesyonel ürün fotoğrafları oluşturmaya başlamak için kenar çubuğundan bir fotoğraf çekimi seçin veya yeni bir tane oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть фотосесію на бічній панелі або створіть нову, щоб почати створювати професійні фотографії продуктів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh chụp từ thanh bên hoặc tạo ảnh mới để bắt đầu tạo ảnh sản phẩm chuyên nghiệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏中选择一张照片或创建一张新照片以开始生成专业的产品照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從側邊欄中選擇一張照片或建立新照片以開始產生專業的產品照片。"
          }
        }
      }
    },
    "Choose a playground from the sidebar or create a new one to start generating.": {
      "localizations": {
