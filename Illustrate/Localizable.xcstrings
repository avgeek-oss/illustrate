    "Stay on this page to ensure the bulk edit process continues. Navigating elsewhere will pause the process.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie auf dieser Seite, um sicherzustellen, dass der Massenbearbeitungsprozess fortgesetzt wird. Wenn Sie woanders hin navigieren, wird der Vorgang angehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanezca en esta página para asegurarse de que el proceso de edición masiva continúe. Navegar a otro lugar detendrá el proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez sur cette page pour vous assurer que le processus de modification groupée se poursuit. Naviguer ailleurs mettra le processus en pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सुनिश्चित करने के लिए कि थोक संपादन प्रक्रिया जारी रहे, इस पृष्ठ पर बने रहें। अन्यत्र नेविगेट करने से प्रक्रिया रुक जाएगी."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap di halaman ini untuk memastikan proses pengeditan massal berlanjut. Menavigasi ke tempat lain akan menghentikan proses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括編集プロセスを続行するには、このページに留まり続けてください。他の場所に移動すると、プロセスが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대량 편집 프로세스가 계속 진행되도록 하려면 이 페이지에 머무르세요. 다른 곳으로 이동하면 프로세스가 일시 중지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostań na tej stronie, aby mieć pewność, że proces edycji zbiorczej będzie kontynuowany. Przejście w inne miejsce spowoduje wstrzymanie procesu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permaneça nesta página para garantir que o processo de edição em massa continue. Navegar para outro lugar pausará o processo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplu düzenleme işleminin devam ettiğinden emin olmak için bu sayfada kalın. Başka bir yere gitmek işlemi duraklatacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишайтеся на цій сторінці, щоб забезпечити продовження процесу масового редагування. Навігація в іншому місці призупинить процес."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở lại trang này để đảm bảo quá trình chỉnh sửa hàng loạt được tiếp tục. Điều hướng đến nơi khác sẽ tạm dừng quá trình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留在此页面以确保批量编辑过程继续进行。导航到其他地方将暂停该过程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留在此頁面以確保批量編輯過程繼續進行。導航到其他地方將暫停該過程。"
          }
        }
      }
    },
    "Stay on this page to ensure the bulk generation process continues. Navigating elsewhere will pause the process.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie auf dieser Seite, um sicherzustellen, dass der Massengenerierungsprozess fortgesetzt wird. Wenn Sie woanders hin navigieren, wird der Vorgang angehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanezca en esta página para garantizar que el proceso de generación masiva continúe. Navegar a otro lugar detendrá el proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez sur cette page pour vous assurer que le processus de génération groupée se poursuit. Naviguer ailleurs mettra le processus en pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सुनिश्चित करने के लिए कि थोक उत्पादन प्रक्रिया जारी रहे, इस पृष्ठ पर बने रहें। अन्यत्र नेविगेट करने से प्रक्रिया रुक जाएगी."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap di halaman ini untuk memastikan proses pembuatan massal terus berlanjut. Menavigasi ke tempat lain akan menghentikan proses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括生成プロセスが続行されるようにするには、このページに留まってください。他の場所に移動すると、プロセスが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대량 생성 프로세스가 계속 진행되도록 하려면 이 페이지에 머무르세요. 다른 곳으로 이동하면 프로세스가 일시 중지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostań na tej stronie, aby mieć pewność, że proces generowania zbiorczego będzie kontynuowany. Przejście w inne miejsce spowoduje wstrzymanie procesu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique nesta página para garantir que o processo de geração em massa continue. Navegar para outro lugar pausará o processo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplu oluşturma sürecinin devam etmesini sağlamak için bu sayfada kalın. Başka bir yere gitmek işlemi duraklatacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишайтеся на цій сторінці, щоб забезпечити продовження процесу масового створення. Навігація в іншому місці призупинить процес."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở lại trang này để đảm bảo quá trình tạo số lượng lớn tiếp tục. Điều hướng đến nơi khác sẽ tạm dừng quá trình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留在此页面以确保批量生成过程继续进行。导航到其他地方将暂停该过程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留在此頁面以確保批量生成過程繼續進行。導航到其他地方將暫停該過程。"
          }
        }
      }
    },
