    "Optional negative prompt to avoid certain elements in the generated image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale negative Eingabeaufforderung, um bestimmte Elemente im generierten Bild zu vermeiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje negativo opcional para evitar ciertos elementos en la imagen generada."
          }
