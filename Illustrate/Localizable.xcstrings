    "Rate limit exceeded. Please wait a moment before making more requests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratenlimit überschritten. Bitte warten Sie einen Moment, bevor Sie weitere Anfragen stellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se superó el límite de tarifa. Espere un momento antes de realizar más solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de débit dépassée. Veuillez patienter un moment avant de faire d'autres demandes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर सीमा पार हो गई. कृपया अधिक अनुरोध करने से पहले एक क्षण प्रतीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas tarif terlampaui. Harap tunggu sebentar sebelum mengajukan permintaan lainnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レート制限を超えました。さらにリクエストを行う前に、しばらくお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율 제한을 초과했습니다. 추가 요청을 하기 전에 잠시 기다려 주십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono limit stawki. Poczekaj chwilę, zanim złożysz kolejne prośby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de taxa excedido. Aguarde um momento antes de fazer mais solicitações."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hız limiti aşıldı. Daha fazla istekte bulunmadan önce lütfen biraz bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт швидкості перевищено. Зачекайте трохи, перш ніж надсилати додаткові запити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã vượt quá giới hạn tỷ lệ. Vui lòng đợi một lát trước khi thực hiện thêm yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出速率限制。请稍等片刻，然后再提出更多请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出速率限制。請稍等片刻，然後再提出更多請求。"
          }
        }
      }
    },
