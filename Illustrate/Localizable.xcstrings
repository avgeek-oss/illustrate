    "Brand information is included by default. Select which brand assets to include as references.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeninformationen sind standardmäßig enthalten. Wählen Sie aus, welche Markenwerte als Referenzen einbezogen werden sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de la marca se incluye de forma predeterminada. Seleccione qué activos de marca incluir como referencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations sur la marque sont incluses par défaut. Sélectionnez les actifs de marque à inclure comme références."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रांड जानकारी डिफ़ॉल्ट रूप से शामिल है. संदर्भ के रूप में शामिल करने के लिए कौन सी ब्रांड संपत्तियां चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi merek disertakan secara default. Pilih aset merek mana yang akan disertakan sebagai referensi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランド情報はデフォルトで含まれています。参照として含めるブランド資産を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 브랜드 정보가 포함되어 있습니다. 참조로 포함할 브랜드 자산을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje o marce są dołączane domyślnie. Wybierz, które zasoby marki mają zostać uwzględnione jako referencje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações da marca são incluídas por padrão. Selecione quais ativos de marca incluir como referências."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marka bilgileri varsayılan olarak eklenir. Referans olarak hangi marka varlıklarının dahil edileceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація про бренд включена за замовчуванням. Виберіть, які активи бренду включити як посилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin thương hiệu được bao gồm theo mặc định. Chọn nội dung thương hiệu để đưa vào làm tài liệu tham khảo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下包含品牌信息。选择要包含作为参考的品牌资产。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設包含品牌資訊。選擇要包含作為參考的品牌資產。"
          }
        }
      }
    },
