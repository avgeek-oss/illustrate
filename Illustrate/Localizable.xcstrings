    "Connect your Firecrawl account in the Providers section to enable automatic brand extraction.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Ihr Firecrawl-Konto im Abschnitt „Anbieter“, um die automatische Markenextraktion zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte su cuenta de Firecrawl en la sección Proveedores para habilitar la extracción automática de marca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre compte Firecrawl dans la section Fournisseurs pour activer l'extraction automatique de marque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित ब्रांड निष्कर्षण को सक्षम करने के लिए प्रदाता अनुभाग में अपने फायरक्रॉल खाते को कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan akun Firecrawl Anda di bagian Penyedia untuk mengaktifkan ekstraksi merek otomatis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[プロバイダー] セクションで Firecrawl アカウントを接続し、自動ブランド抽出を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 브랜드 추출을 활성화하려면 공급자 섹션에서 Firecrawl 계정을 연결하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz swoje konto Firecrawl w sekcji Dostawcy, aby umożliwić automatyczne wyodrębnianie marki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte sua conta Firecrawl na seção Provedores para ativar a extração automática de marca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik marka çıkarmayı etkinleştirmek için Firecrawl hesabınızı Sağlayıcılar bölümüne bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть свій обліковий запис Firecrawl у розділі «Постачальники», щоб увімкнути автоматичне вилучення бренду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối tài khoản Firecrawl của bạn trong phần Nhà cung cấp để kích hoạt trích xuất thương hiệu tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“提供商”部分连接您的 Firecrawl 帐户以启用自动品牌提取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「提供者」部分連接您的 Firecrawl 帳戶以啟用自動品牌提取。"
          }
        }
      }
    },
