    "Images will be skipped. You can manually upload logos and assets later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder werden übersprungen. Sie können Logos und Assets später manuell hochladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitirán las imágenes. Puede cargar logotipos y recursos manualmente más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images seront ignorées. Vous pourrez télécharger manuellement des logos et des ressources ultérieurement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवियाँ छोड़ दी जाएंगी. आप बाद में लोगो और संपत्तियों को मैन्युअल रूप से अपलोड कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar akan dilewati. Anda dapat mengunggah logo dan aset secara manual nanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像はスキップされます。ロゴとアセットは後で手動でアップロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 건너뜁니다. 나중에 로고와 자산을 수동으로 업로드할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazy zostaną pominięte. Możesz później ręcznie przesłać logo i zasoby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens serão ignoradas. Você pode fazer upload manual de logotipos e ativos posteriormente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimler atlanacak. Logoları ve varlıkları daha sonra manuel olarak yükleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення будуть пропущені. Ви можете вручну завантажити логотипи та ресурси пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh sẽ bị bỏ qua. Bạn có thể tải lên logo và nội dung theo cách thủ công sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像将被跳过。您可以稍后手动上传徽标和资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影像將被跳過。您可以稍後手動上傳徽標和資源。"
          }
        }
      }
    },
    "Imagine an image and generate in seconds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sich ein Bild vor und generieren Sie es in Sekundenschnelle"
          }
