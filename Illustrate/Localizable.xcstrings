    "Generations will appear here as you edit the canvas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während Sie die Leinwand bearbeiten, werden hier Generationen angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las generaciones aparecerán aquí a medida que edites el lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les générations apparaîtront ici au fur et à mesure que vous modifierez le canevas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही आप कैनवास संपादित करेंगे, पीढ़ियाँ यहाँ दिखाई देंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Generasi akan muncul di sini saat Anda mengedit kanvas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスを編集すると、ここに世代が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 편집하면 여기에 세대가 나타납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokolenia pojawią się tutaj podczas edycji obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gerações aparecerão aqui conforme você edita a tela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz tuvali düzenlerken nesiller burada görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час редагування полотна тут відображатимуться покоління."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thế hệ sẽ xuất hiện ở đây khi bạn chỉnh sửa canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您编辑画布时，世代将出现在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您編輯畫布時，世代將出現在此。"
          }
        }
      }
    },
