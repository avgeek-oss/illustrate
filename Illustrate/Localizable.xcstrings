    "Actual cost may vary based on provider pricing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die tatsächlichen Kosten können je nach Anbieterpreis variieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El costo real puede variar según los precios del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coût réel peut varier en fonction des tarifs du fournisseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रदाता मूल्य निर्धारण के आधार पर वास्तविक लागत भिन्न हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya sebenarnya dapat bervariasi berdasarkan harga penyedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の費用はプロバイダーの価格設定によって異なる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 비용은 공급자 가격에 따라 달라질 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzeczywisty koszt może się różnić w zależności od cen dostawcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo real pode variar com base nos preços do fornecedor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek maliyet, sağlayıcının fiyatlandırmasına bağlı olarak değişebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фактична вартість може відрізнятися залежно від цін постачальника."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi phí thực tế có thể thay đổi tùy theo giá của nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际成本可能会根据提供商的定价而有所不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際成本可能會根據提供者的定價而有所不同。"
          }
        }
      }
    },
