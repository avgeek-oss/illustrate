            "value": "Ten wątek i wszystkie zawarte w nim wiadomości zostaną trwale usunięte. Tej akcji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tópico e todas as suas mensagens serão excluídas permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konu ve içindeki tüm mesajlar kalıcı olarak silinecek. Bu eylem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей ланцюжок і всі повідомлення в ньому буде видалено назавжди. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề này và tất cả tin nhắn của nó sẽ bị xóa vĩnh viễn. Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该帖子及其所有消息将被永久删除。此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該帖子及其所有訊息將永久刪除。此操作無法撤銷。"
          }
        }
      }
    },
    "This will permanently delete data and asset files in this project. Other projects are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Daten und Asset-Dateien in diesem Projekt dauerhaft gelöscht. Andere Projekte sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente los archivos de datos y activos de este proyecto. Otros proyectos no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement les données et les fichiers d'actifs de ce projet. Les autres projets ne sont pas concernés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस प्रोजेक्ट में डेटा और संपत्ति फ़ाइलें स्थायी रूप से हटा दी जाएंगी। अन्य परियोजनाएं प्रभावित नहीं होंगी."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan menghapus data dan file aset dalam proyek ini secara permanen. Proyek lain tidak terpengaruh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、このプロジェクト内のデータとアセット ファイルが完全に削除されます。他のプロジェクトには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트의 데이터와 자산 파일이 영구적으로 삭제됩니다. 다른 프로젝트는 영향을 받지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie danych i plików zasobów w tym projekcie. Nie ma to wpływu na inne projekty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá permanentemente os dados e arquivos de ativos deste projeto. Outros projetos não são afetados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu projedeki verileri ve varlık dosyalarını kalıcı olarak silecektir. Diğer projeler etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це призведе до остаточного видалення файлів даних і активів у цьому проекті. На інші проекти це не впливає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn các tệp dữ liệu và nội dung trong dự án này. Các dự án khác không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除该项目中的数据和资产文件。其他项目不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除該項目中的資料和資產檔案。其他項目不受影響。"
          }
        }
      }
    },
    "This will permanently delete the project '%@' along with all its provider keys, generations, and associated files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Projekt „%@“ zusammen mit allen seinen Anbieterschlüsseln, Generationen und zugehörigen Dateien dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente el proyecto '%@' junto con todas sus claves de proveedor, generaciones y archivos asociados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement le projet « %@ » ainsi que toutes ses clés de fournisseur, générations et fichiers associés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रोजेक्ट '%@' को उसकी सभी प्रदाता कुंजियों, पीढ़ियों और संबंधित फ़ाइलों के साथ स्थायी रूप से हटा देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan menghapus proyek '%@' secara permanen beserta semua kunci penyedia, generasi, dan file terkaitnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、プロジェクト「%@」が、そのすべてのプロバイダー キー、世代、および関連ファイルとともに完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 모든 공급자 키, 세대 및 관련 파일과 함께 '%@' 프로젝트가 영구적으로 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie projektu „%@” wraz ze wszystkimi jego kluczami dostawców, generacjami i powiązanymi plikami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá permanentemente o projeto '%@' junto com todas as suas chaves de provedor, gerações e arquivos associados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, '%@' projesini tüm sağlayıcı anahtarları, nesilleri ve ilişkili dosyalarıyla birlikte kalıcı olarak silecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це призведе до остаточного видалення проекту «%@» разом із усіма його ключами постачальника, поколіннями та пов’язаними файлами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn dự án '%@' cùng với tất cả các khóa, thế hệ và tệp liên quan của nhà cung cấp dự án."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除项目“%@”及其所有提供程序密钥、生成和关联文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除專案「%@」及其所有提供者金鑰、產生和關聯檔案。"
          }
        }
      }
    },
    "This will permanently erase ALL application data across all projects. There is no undo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden ALLE Anwendungsdaten aller Projekte dauerhaft gelöscht. Es gibt kein Rückgängigmachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará permanentemente TODOS los datos de la aplicación en todos los proyectos. No hay forma de deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera définitivement TOUTES les données d’application sur tous les projets. Il n'y a pas d'annulation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी प्रोजेक्टों से सभी एप्लिकेशन डेटा को स्थायी रूप से मिटा देगा। कोई पूर्ववत नहीं है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus secara permanen SEMUA data aplikasi di semua proyek. Tidak ada pembatalan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのプロジェクトのすべてのアプリケーション データが永久に消去されます。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 모든 프로젝트의 모든 애플리케이션 데이터가 영구적으로 삭제됩니다. 실행 취소할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie WSZYSTKICH danych aplikacji we wszystkich projektach. Nie ma możliwości cofnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apagará permanentemente TODOS os dados do aplicativo em todos os projetos. Não há como desfazer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tüm projelerdeki TÜM uygulama verilerini kalıcı olarak silecektir. Geri alma yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить УСІ дані програми в усіх проектах. Відмінити не можна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ xóa vĩnh viễn TẤT CẢ dữ liệu ứng dụng trên tất cả các dự án. Không có hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有项目中的所有应用程序数据。无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除所有項目中的所有應用程式資料。無法撤銷。"
          }
        }
      }
    },
    "This will permanently erase all application data across all projects. This includes all generated images, videos, agents, brand kits, chat threads, playgrounds, storyboards, provider connections, cached files, and iCloud documents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Anwendungsdaten aller Projekte dauerhaft gelöscht. Dazu gehören alle generierten Bilder, Videos, Agenten, Markenkits, Chat-Threads, Playgrounds, Storyboards, Anbieterverbindungen, zwischengespeicherten Dateien und iCloud-Dokumente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará permanentemente todos los datos de la aplicación en todos los proyectos. Esto incluye todas las imágenes, vídeos, agentes, kits de marca, hilos de chat, áreas de juego, guiones gráficos, conexiones de proveedores, archivos en caché y documentos de iCloud generados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera définitivement toutes les données d’application de tous les projets. Cela inclut toutes les images, vidéos, agents, kits de marque, fils de discussion, terrains de jeux, storyboards, connexions de fournisseurs, fichiers mis en cache et documents iCloud générés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी प्रोजेक्टों से सभी एप्लिकेशन डेटा को स्थायी रूप से मिटा देगा। इसमें सभी उत्पन्न छवियां, वीडियो, एजेंट, ब्रांड किट, चैट थ्रेड, खेल के मैदान, स्टोरीबोर्ड, प्रदाता कनेक्शन, कैश्ड फ़ाइलें और iCloud दस्तावेज़ शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus secara permanen semua data aplikasi di semua proyek. Ini mencakup semua gambar, video, agen, kit merek, rangkaian obrolan, taman bermain, papan cerita, koneksi penyedia, file cache, dan dokumen iCloud yang dihasilkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのプロジェクトのすべてのアプリケーション データが永久に消去されます。これには、生成されたすべての画像、ビデオ、エージェント、ブランド キット、チャット スレッド、プレイグラウンド、ストーリーボード、プロバイダー接続、キャッシュされたファイル、および iCloud ドキュメントが含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 모든 프로젝트의 모든 애플리케이션 데이터가 영구적으로 삭제됩니다. 여기에는 생성된 모든 이미지, 비디오, 에이전트, 브랜드 키트, 채팅 스레드, 플레이그라운드, 스토리보드, 공급자 연결, 캐시된 파일 및 iCloud 문서가 포함됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie wszystkich danych aplikacji we wszystkich projektach. Obejmuje to wszystkie wygenerowane obrazy, filmy, agentów, zestawy marek, wątki czatu, place zabaw, scenorysy, połączenia z dostawcami, pliki w pamięci podręcznej i dokumenty iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apagará permanentemente todos os dados do aplicativo em todos os projetos. Isso inclui todas as imagens geradas, vídeos, agentes, kits de marca, tópicos de bate-papo, playgrounds, storyboards, conexões de provedores, arquivos em cache e documentos do iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tüm projelerdeki tüm uygulama verilerini kalıcı olarak silecektir. Buna, oluşturulan tüm görseller, videolar, aracılar, marka kitleri, sohbet dizileri, oyun alanları, storyboard'lar, sağlayıcı bağlantıları, önbelleğe alınmış dosyalar ve iCloud belgeleri dahildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі дані програми в усіх проектах. Сюди входять усі згенеровані зображення, відео, агенти, набори брендів, ланцюжки чатів, ігрові майданчики, розкадровки, підключення до постачальників, кешовані файли та документи iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ xóa vĩnh viễn tất cả dữ liệu ứng dụng trên tất cả các dự án. Điều này bao gồm tất cả hình ảnh, video, đại lý, bộ thương hiệu, chuỗi trò chuyện, sân chơi, bảng phân cảnh, kết nối nhà cung cấp, tệp được lưu trong bộ nhớ đệm và tài liệu iCloud được tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有项目中的所有应用程序数据。这包括所有生成的图像、视频、代理、品牌套件、聊天线程、游乐场、故事板、提供商连接、缓存文件和 iCloud 文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除所有項目中的所有應用程式資料。這包括所有生成的圖像、視訊、代理、品牌套件、聊天線程、遊樂場、故事板、提供者連接、快取檔案和 iCloud 文件。"
          }
        }
      }
    },
    "This will rearrange all cards on the canvas. This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Karten auf der Leinwand neu angeordnet. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reorganizará todas las cartas en el lienzo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela réorganisera toutes les cartes sur la toile. Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैनवास पर सभी कार्डों को पुनर्व्यवस्थित करेगा। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengatur ulang semua kartu di kanvas. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、キャンバス上のすべてのカードが再配置されます。この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 캔버스의 모든 카드가 재정렬됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to zmianę układu wszystkich kart na płótnie. Tej akcji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso reorganizará todos os cartões na tela. Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tuvaldeki tüm kartları yeniden düzenleyecektir. Bu eylem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це переставить усі картки на полотні. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ sắp xếp lại tất cả các thẻ trên khung vẽ. Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将重新排列画布上的所有卡片。此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將重新排列畫布上的所有卡片。此操作無法撤銷。"
          }
        }
      }
    },
    "This will replace the current scene with a newly generated video.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die aktuelle Szene durch ein neu generiertes Video ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplazará la escena actual con un video recién generado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplacera la scène actuelle par une vidéo nouvellement générée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वर्तमान दृश्य को एक नए जेनरेट किए गए वीडियो से बदल देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menggantikan adegan saat ini dengan video yang baru dibuat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、現在のシーンが新しく生成されたビデオに置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 현재 장면이 새로 생성된 비디오로 대체됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to zastąpienie bieżącej sceny nowo wygenerowanym wideo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso substituirá a cena atual por um vídeo recém-gerado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, mevcut sahneyi yeni oluşturulan bir videoyla değiştirecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить поточну сцену на щойно створене відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ thay thế cảnh hiện tại bằng một video mới được tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将用新生成的视频替换当前场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將用新生成的影片取代當前場景。"
          }
        }
      }
    },
