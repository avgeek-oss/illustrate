          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemleri önce Bilgi İstemi Galerinize kaydedin, ardından buradan seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
