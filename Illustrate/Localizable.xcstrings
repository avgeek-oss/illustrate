          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda a janela para acessar este recurso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özelliğe erişmek için lütfen pencereyi genişletin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримати доступ до цієї функції, розгорніть вікно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng mở rộng cửa sổ để truy cập tính năng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
