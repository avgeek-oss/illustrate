    "Save prompts to your Prompt Gallery first, then pick them here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Eingabeaufforderungen zunächst in Ihrer Eingabeaufforderungsgalerie und wählen Sie sie dann hier aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero guarde las indicaciones en su Galería de indicaciones y luego selecciónelas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez d'abord les invites dans votre galerie d'invites, puis sélectionnez-les ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले संकेतों को अपनी प्रॉम्प्ट गैलरी में सहेजें, फिर उन्हें यहां चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan perintah ke Galeri Prompt Anda terlebih dahulu, lalu pilih di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずプロンプトをプロンプト ギャラリーに保存してから、ここで選択します。"
          }
